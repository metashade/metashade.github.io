{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MkDocs Serve",
            "type": "debugpy",
            "request": "launch",
            "module": "mkdocs",
            "args": ["serve", "--dev-addr", "127.0.0.1:8000"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {"PYTHONDONTWRITEBYTECODE": "1"}
        }
    ]
}
